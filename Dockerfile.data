# Container image for TPT Data Validator (tpt-data).
#
# Build:  docker build -f Dockerfile.data -t tpt/data .
# Validate a CSV, JSON or JSON Lines file. Input is mounted read-only, and
# results are written to /out, which must be a writable mount:
#   docker run --rm -v "$PWD/data:/data:ro" -v "$PWD/out:/out" tpt/data \
#     validate --schema /data/customer.schema.yaml /data/customers.csv --out /out

FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p tpt-data

FROM debian:bookworm-slim
RUN useradd --system --uid 10001 tpt && mkdir /out && chown tpt /out
COPY --from=build /src/target/release/tpt-data /usr/local/bin/tpt-data
USER tpt
WORKDIR /data
ENTRYPOINT ["tpt-data"]
CMD ["--help"]
